# Local development with Mailpit (copy to .env and adjust as needed)
MAILPIT=1
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@mleczki.pl

# Production email (Brevo) — used when SMTP_HOST and MAILPIT are unset
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=noreply@mleczki.pl
# MAIL_REPLY_TO=do@mleczki.pl

# Bank notifications (BLIK / transfers) via Cloudflare Email Routing -> Worker -> POST /api/bank-mail.
# Generate once with scripts/setup-bank-mail-secrets.sh (never rotated automatically).
# BANK_MAIL_ADDRESS=<32 random hex>@cargo.mleczki.pl
# BANK_MAIL_WEBHOOK_SECRET=<64 random hex>
# BANK_MAIL_FROM=powiadomienia@alior.pl
# BANK_MAIL_CHECK_FROM=1  # set to 0 only for controlled tests

# Shop: unpaid orders holding shop stock are cancelled after this many hours (0 = never expire).
# SHOP_RESERVATION_TTL_HOURS=48

# Public address used in canonical links, previews and the sitemap.
# SITE_URL=https://cargo.mleczki.pl

# Delivery through Polkurier (see docs/shop.md). Without these only collection in person is offered.
# POLKURIER_LOGIN=
# POLKURIER_TOKEN=
# POLKURIER_SANDBOX=false   # defaults to true (test environment)
